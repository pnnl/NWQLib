{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nwqlib:contract-specimen:1",
  "title": "Bounded analytical Lanczos contract specimen v1",
  "description": "Structural fragments for this development fixture. The companion checker owns cross-record and scientific premise validation; this is not a general NWQLib public schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"const": "nwqlib.contract-specimen/1"},
    "records": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {"id": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "rational": {"type": "string", "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$"},
    "matrix2": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/rational"}}
    },
    "node": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "block"],
         "properties": {"type": {"const": "BlockCall"}, "block": {"type": "string"}, "qubits": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 6}}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "children"],
         "properties": {"type": {"const": "Sequence"}, "children": {"type": "array", "items": {"$ref": "#/$defs/node"}}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "count", "body"],
         "properties": {"type": {"const": "Repeat"}, "count": {"type": "integer", "minimum": 0}, "body": {"$ref": "#/$defs/node"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "settings"],
         "properties": {"type": {"const": "MeasurementBatch"}, "settings": {"type": "array", "items": {
           "type": "object", "additionalProperties": false, "required": ["id", "degree", "body"],
           "properties": {"id": {"type": "string"}, "degree": {"enum": [1, 2, 3]}, "body": {"$ref": "#/$defs/node"}}
         }}}}
      ]
    },
    "program": {
      "type": "object", "additionalProperties": false, "required": ["definitions", "root"],
      "properties": {"definitions": {"type": "object", "additionalProperties": {"$ref": "#/$defs/node"}}, "root": {"$ref": "#/$defs/node"}}
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "payload", "refs", "sha256"],
      "properties": {
        "id": {"enum": ["request", "plan", "realization", "prepared", "workload", "profile", "allocation", "assessment", "trace", "observations", "result", "errors", "provenance", "claims"]},
        "kind": {"enum": ["Request", "Plan", "Realization", "PreparedArtifact", "WorkloadEstimate", "DeviceProfile", "Allocation", "Assessment", "ExecutionTrace", "ObservationView", "Result", "ErrorModel", "Provenance", "ClaimAssessments"]},
        "payload": {"type": "object"},
        "refs": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "Request"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/request"}}}},
        {"if": {"properties": {"kind": {"const": "Plan"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/plan"}}}},
        {"if": {"properties": {"kind": {"const": "Realization"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/realization"}}}},
        {"if": {"properties": {"kind": {"const": "PreparedArtifact"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/prepared"}}}},
        {"if": {"properties": {"kind": {"const": "WorkloadEstimate"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/workload"}}}},
        {"if": {"properties": {"kind": {"const": "DeviceProfile"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/profile"}}}},
        {"if": {"properties": {"kind": {"const": "Allocation"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/allocation"}}}},
        {"if": {"properties": {"kind": {"const": "Assessment"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/assessment"}}}},
        {"if": {"properties": {"kind": {"const": "ExecutionTrace"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/trace"}}}},
        {"if": {"properties": {"kind": {"const": "ObservationView"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/observations"}}}},
        {"if": {"properties": {"kind": {"const": "Result"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/result"}}}},
        {"if": {"properties": {"kind": {"const": "ErrorModel"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/errors"}}}},
        {"if": {"properties": {"kind": {"const": "Provenance"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/provenance"}}}},
        {"if": {"properties": {"kind": {"const": "ClaimAssessments"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/claims"}}}}
      ]
    },
    "request": {
      "type": "object", "required": ["hamiltonian", "reference", "system_qubits", "qubit_order", "label_order", "output", "accuracy_target"],
      "properties": {"hamiltonian": {"type": "object"}, "reference": {"type": "object"}, "system_qubits": {"type": "integer"}, "qubit_order": {"type": "string"}, "label_order": {"type": "string"}, "output": {"type": "string"}, "accuracy_target": {"type": "object"}}
    },
    "plan": {
      "type": "object", "required": ["algorithm", "krylov_dimension", "alpha", "required_moments", "known_moments", "registers", "program", "block_semantics", "readout", "phase_budgets"],
      "properties": {"algorithm": {"type": "string"}, "krylov_dimension": {"type": "integer"}, "alpha": {"type": "number", "exclusiveMinimum": 0}, "required_moments": {"type": "array", "uniqueItems": true, "items": {"type": "integer"}}, "known_moments": {"type": "object", "additionalProperties": {"$ref": "#/$defs/rational"}}, "registers": {"type": "object"}, "program": {"$ref": "#/$defs/program"}, "block_semantics": {"type": "object"}, "readout": {"type": "object"}, "phase_budgets": {"type": "object"}}
    },
    "realization": {
      "type": "object", "required": ["choice", "reference", "bindings", "evidence_kind"],
      "properties": {"choice": {"enum": ["direct_x", "hzh"]}, "reference": {"$ref": "#/$defs/node"}, "bindings": {"type": "string"}, "evidence_kind": {"type": "string"}}
    },
    "prepared": {
      "type": "object", "required": ["format", "program", "program_sha256", "lifecycle", "target_compilation", "submission_ready", "compiler", "target", "layout", "remaining_requirements"],
      "properties": {"program": {"$ref": "#/$defs/program"}, "program_sha256": {"$ref": "#/$defs/sha256"}, "submission_ready": {"type": "boolean"}, "remaining_requirements": {"type": "array", "items": {"type": "string"}}}
    },
    "workload": {
      "type": "object", "required": ["stage", "lifecycle", "population", "basis", "inventory", "unit", "evidence_kind", "system_width", "index_width", "logical_width", "required_settings", "stored_walk_definitions", "native_gates", "T_count", "compiled_depth", "compiler_workspace_bytes", "runtime_seconds", "currency_cost", "unknown_reason"],
      "properties": {"inventory": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "basis": {"type": "array", "items": {"type": "string"}}, "logical_width": {"type": "integer", "minimum": 1}}
    },
    "profile": {"type": "object", "required": ["name", "version", "capabilities", "device_qubit_capacity", "workspace_model", "runtime_model", "calibration", "freshness"]},
    "allocation": {"type": "object", "required": ["device_qubits", "memory_bytes", "concurrency", "backend_jobs_allowed"]},
    "assessment": {"type": "object", "required": ["logical_width", "capacity", "runtime", "cost", "real_submission", "reason"]},
    "trace": {
      "type": "object", "required": ["status", "evidence_kind", "prepared_id", "target", "planned_settings", "logical_prepared_settings", "target_prepared_settings", "submitted_settings", "executed_settings", "returned_shots", "backend_jobs", "measured_runtime_seconds", "fixture_events"],
      "properties": {"status": {"enum": ["fixture_complete", "fixture_partial"]}, "planned_settings": {"type": "integer", "minimum": 0}, "logical_prepared_settings": {"type": "integer", "minimum": 0}, "target_prepared_settings": {"type": "integer", "minimum": 0}, "submitted_settings": {"type": "integer", "minimum": 0}, "executed_settings": {"type": "integer", "minimum": 0}, "returned_shots": {"type": "integer", "minimum": 0}, "fixture_events": {"type": "array", "items": {"type": "object", "required": ["id", "setting", "attempt", "chunk", "source"]}}}
    },
    "observations": {
      "type": "object", "required": ["coverage", "kind", "known_moments", "contributions"],
      "properties": {"coverage": {"enum": ["complete", "partial"]}, "kind": {"const": "exact_expectation_fixture"}, "known_moments": {"type": "object", "additionalProperties": {"$ref": "#/$defs/rational"}}, "contributions": {"type": "array", "items": {
        "type": "object", "required": ["setting", "degree", "expectation", "trace_event", "attempt", "chunk", "prepared_id", "parameter_point", "measured_qubits", "returned_shots", "conditioning", "uncertainty"],
        "properties": {"degree": {"enum": [1, 2, 3]}, "expectation": {"$ref": "#/$defs/rational"}, "measured_qubits": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 6}}, "returned_shots": {"type": ["null", "integer"], "minimum": 0}}
      }}}
    },
    "result": {
      "type": "object", "required": ["type", "status", "coverage", "unit", "pencil", "energy", "interpretation", "statistical_interval", "ground_accuracy_certificate", "evidence_kind", "missing_moments"],
      "properties": {"type": {"const": "ProjectedEnergyResult"}, "status": {"enum": ["final", "unavailable"]}, "coverage": {"enum": ["complete", "partial"]}, "pencil": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["overlap", "hamiltonian"], "properties": {"overlap": {"$ref": "#/$defs/matrix2"}, "hamiltonian": {"$ref": "#/$defs/matrix2"}}}]}, "energy": {"type": ["null", "object"]}, "ground_accuracy_certificate": {"type": "boolean"}, "missing_moments": {"type": "array", "uniqueItems": true, "items": {"enum": [1, 2, 3]}}}
    },
    "errors": {
      "type": "object", "required": ["target", "unit", "terms", "requested_accuracy", "backend_total_error_bound"],
      "properties": {"requested_accuracy": {"$ref": "#/$defs/rational"}, "terms": {"type": "array", "items": {"type": "object", "required": ["name", "evidence_kind", "composition_role", "coverage", "bound"], "properties": {"composition_role": {"enum": ["listed_only", "conditional_term"]}, "bound": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/rational"}]}}}}}
    },
    "provenance": {"type": "object", "required": ["origin", "generator", "source_revision", "source_revision_role", "software_environment", "moment_evidence", "ground_evidence", "data_storage"], "properties": {"ground_evidence": {"type": ["null", "object"]}}},
    "claims": {
      "type": "object", "required": ["assessments", "target_status"],
      "properties": {"assessments": {"type": "array", "items": {"type": "object", "required": ["claim", "status", "method", "coverage"], "properties": {"status": {"enum": ["PASS", "FAIL", "NOT_RUN", "INCONCLUSIVE", "NOT_APPLICABLE"]}}}}}
    }
  }
}
